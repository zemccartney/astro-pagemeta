{
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "eslint.options": {
        "flags": ["unstable_native_nodejs_ts_config"]
    },
    "eslint.probe": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact",
        "html",
        "markdown",
        "json",
        "jsonc",
        "astro"
    ],
    "search.exclude": {
        "**/node_modules": true,
        "**/pnpm-lock.json": true
    }
}
