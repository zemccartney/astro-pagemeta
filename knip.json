{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "ignore": ["image-gen-wip/**"],
    "ignoreWorkspaces": ["playground"],
    "tags": ["-lintignore"],
    "workspaces": {
        ".": {
            "entry": ["scripts/*.ts"]
        },
        "packages/astro-fixture": {
            "entry": ["src/astroFixture.ts", "src/testAdapter.ts"]
        },
        "packages/ephemeris": {
            "entry": ["bench/*.bench.ts", "bench/fixtures/generate.ts"],
            "ignore": ["scripts/**", "tests/**", "src/virtual.d.ts"],
            "ignoreDependencies": ["schema-dts"]
        }
    }
}
