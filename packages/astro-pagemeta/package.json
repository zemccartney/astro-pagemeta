{
    "name": "@grepco/astro-pagemeta",
    "version": "0.0.0",
    "description": "An Astro integration for setting your pages' meta tags",
    "keywords": [
        "astro",
        "astro-integration",
        "seo"
    ],
    "homepage": "https://github.com/zemccartney/astro-pagemeta",
    "bugs": {
        "url": "https://github.com/zemccartney/astro-pagemeta/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zemccartney/astro-pagemeta.git"
    },
    "license": "MIT",
    "author": "Zack McCartney <zack@grepco.net>",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        },
        "./Head": "./src/Head.astro",
        "./runtime": {
            "types": "./dist/runtime.d.mts",
            "import": "./dist/runtime.mjs"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "bench": "vitest bench --run",
        "bench:report": "node scripts/bench-report.ts",
        "build": "tsdown",
        "check:engines": "node scripts/check-engines.ts",
        "dev": "tsdown --watch",
        "pretest": "tsdown",
        "test": "vitest --run",
        "typecheck": "tsdown && tsc -b"
    },
    "dependencies": {
        "astro-integration-kit": "^0.19.1",
        "hast-util-select": "^6.0.4",
        "rehype": "^13.0.2",
        "rehype-meta": "^4.0.1",
        "rehype-minify-whitespace": "^6.0.2",
        "schema-dts": "^1.1.5"
    },
    "devDependencies": {
        "@arethetypeswrong/core": "^0.18.2",
        "@inox-tools/astro-tests": "^0.8.1",
        "@types/hast": "^3.0.4",
        "@types/node": "catalog:",
        "astro": "catalog:",
        "publint": "^0.3.18",
        "rehype-parse": "^9.0.1",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "unified": "^11.0.5",
        "vite": "^6.4.1",
        "vitest": "^4.0.18"
    },
    "peerDependencies": {
        "astro": "^5.0.0"
    },
    "engines": {
        "node": "24"
    },
    "publishConfig": {
        "engines": {
            "node": "18.20.8 || ^20.3.0 || >=22.0.0"
        }
    }
}
