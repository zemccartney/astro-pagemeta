---
import Head from "@grepco/astro-pagemeta/Head";
import { setPagemeta } from "@grepco/astro-pagemeta/runtime";

import Styled from "../components/Styled.astro";

setPagemeta(Astro, {
    description: "Page with styled component",
    title: "Styled Page"
});
---

<!doctype html>
<html lang="en">
    <Head>
        <meta charset="utf-8" />
    </Head>
    <body>
        <Styled />
    </body>
</html>
