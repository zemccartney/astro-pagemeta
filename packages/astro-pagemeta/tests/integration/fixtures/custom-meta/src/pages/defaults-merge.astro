---
import { metadata } from "@grepco/astro-pagemeta/runtime";

// Page custom should deep-merge with defaults' custom
metadata(Astro, {
    custom: { generator: "Custom Generator", viewport: "width=device-width" }
});
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
    </head>
    <body>
        <p>Page meta merges with defaults meta</p>
    </body>
</html>
