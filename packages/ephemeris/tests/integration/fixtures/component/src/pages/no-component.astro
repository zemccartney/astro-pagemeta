---
import { metadata } from "@grepco/astro-pagemeta/runtime";

// metadata is called, but no <Pagemeta> component is used.
// In manual mode, nothing should be injected without the component or middleware.
metadata(Astro, {
    description: "This should not appear",
    title: "Should Not Appear"
});
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
    </head>
    <body>
        <p>Page without Pagemeta component</p>
    </body>
</html>
