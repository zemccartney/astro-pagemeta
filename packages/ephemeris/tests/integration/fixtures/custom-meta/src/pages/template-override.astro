---
import { metadata } from "@grepco/astro-pagemeta/runtime";

metadata(Astro, {
    custom: { robots: "noindex, nofollow" },
    title: "Template Override Test"
});
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta
            content="index, follow"
            name="robots"
        />
    </head>
    <body>
        <p>Template has robots meta, metadata replaces it</p>
    </body>
</html>
