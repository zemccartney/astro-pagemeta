---
import { setPagemeta } from "../../../src/runtime";

setPagemeta(Astro, {
    description: "English page description",
    title: "English Page",
    // origin: "bunga.com",
    origin: null,
    pathname: "/zzz",
    separator: " ",
    og: true,
    type: null,
    image: null,
    name: null,
    ogNameInTitle: true,
    jsonLd: {
        "@type": "ArtGallery",
        "@id": "111",
        acceptedPaymentMethod: "card"
    },
    custom: {
        // title: "ZZZZ",
        "og:image:alt": "My alt text"
        // "link:rel:canonical": "DUNGA.com"
    }
});
