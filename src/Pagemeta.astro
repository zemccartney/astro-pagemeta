/*
WHY?

- rehype-parse in fragment mode appears to open head elements i.e. <head><meta></head> seems
to turn to <meta><head> in its internal representation?
- rehype-meta only acts on documents, adds head element

<head> must be static in template to not break astro's asset insertion


```ts
import { rehype } from "rehype";
import rehypeMeta from "rehype-meta";

const processed = await rehype()
    .data({ settings: { fragment: true } })
    .use(rehypeMeta, {
        title: "zzz"
    })
    .process(
        `<meta charset="UTF-8"><meta content="width=device-width" name="viewport"><title>Streaming demo</title>`
    );

console.log(processed.toString());
```

Yields:

```html
    <meta charset="UTF-8"><meta content="width=device-width" name="viewport"><title>Streaming demo</title><head>
    <title>zzz</title>
    </head>
```

As we can see, rehype-meta appends a new "document" after fragment input, does not override matched tags
*/

// TODO relative import ok? Still resolves correctly when imported by user?
import {
    _getHtmlProcessor,
    rehypeHeadContentsOnly,
    resolvePagemeta
} from "./runtime";

const metadata = resolvePagemeta(Astro);
const templateMeta = await Astro.slots.render("default");

let head;
if (metadata) {
    // TODO how does minification fit in here? How does minification work in SSR, if at all? doesn't?
    const processor = _getHtmlProcessor({
        metadata
    });

    // TODO dummy, rehype-meta works only on fragments, opens head elements
    // useful finding, that can inject HTML directly
    // think about the API you want... sensible to limit to rehype-meta-supported-tags
    head = await processor.use(rehypeHeadContentsOnly).process(templateMeta);
}

// TODO interesting property: this component works with auto mode, too
---

<Fragment set:html={head ? String(head) : templateMeta} />
