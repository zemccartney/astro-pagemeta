---
/*
 * Streaming-compatible meta tag renderer. Renders inside a static <head>
 * element, preserving Astro's HTML streaming.
 *
 * Reuses the same rehype pipeline as the auto-mode middleware. Slot children
 * (template meta tags) are processed through rehype-meta, which handles
 * deduplication within the slot scope — e.g., a template <title> is
 * replaced if setPagemeta() sets a title.
 *
 * Requirements:
 * - Must be inside a static <head> element (Astro needs it for asset injection)
 * - Must be declared in every layout that has its own <head>
 *
 * Why rehypeHeadContentsOnly instead of rehype's fragment mode:
 * rehype-meta only operates on documents (it looks for a <head> element).
 * In fragment mode, rehype-parse opens head elements incorrectly — given
 * `<meta charset="UTF-8"><title>Demo</title>`, rehype-meta appends a new
 * <head> after the fragment input rather than modifying matched tags:
 *
 *   rehype()
 *     .data({ settings: { fragment: true } })
 *     .use(rehypeMeta, { title: "Override" })
 *     .process('<meta charset="UTF-8"><title>Demo</title>')
 *
 *   // Yields:
 *   // <meta charset="UTF-8"><title>Demo</title><head><title>Override</title></head>
 *
 * So we process in document mode (rehype wraps input in <html><head>...</head></html>),
 * let rehype-meta operate normally on the <head>, then strip the wrapper with
 * rehypeHeadContentsOnly to get just the head children for inline rendering.
 *
 * For a hugely helpful resource on Astro's streaming behavior, especially how slot rendering
 * can break Astro's styles injection: https://angelika.me/2025/03/16/implications-of-astro-html-streaming/
 */
import Processor from "./runtime";

const metadata = Processor.resolvePagemeta(Astro);
const templateMeta =
    Astro.slots.has("default") ? await Astro.slots.render("default") : "";

let head;
if (metadata) {
    const processor = Processor.getHtmlProcessor({ fragment: true, metadata });
    head = await processor.process(templateMeta);
}
---

<Fragment set:html={head ? String(head) : templateMeta} />
