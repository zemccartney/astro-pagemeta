---
import { setPagemeta } from "@grepco/astro-pagemeta/runtime";

// Explicitly sets title to false — a user might expect this to remove
// the template title, but rehype-meta only replaces with truthy values.
setPagemeta(Astro, {
    description: "Description from setPagemeta",
    // negation, which would undo default setting, doesn't delete hardcoded elements
    // eslint-disable-next-line unicorn/no-null -- null feels like clearer indicator of intentional negation
    title: null
});
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title>Template Title</title>
    </head>
    <body>
        <p>
            Tests that setting title to false in setPagemeta does not remove a
            template title
        </p>
    </body>
</html>
