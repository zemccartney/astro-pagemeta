{
    "compilerOptions": {
        // environment
        "lib": ["esnext"],
        "module": "nodenext",
        "skipLibCheck": true,
        "target": "es2022",
        "types": [
            // pull in to support using astro: protocol modules within our test fixtures, for which we never generate
            // types outside our temp directories (see the isolatedFixture utility)
            "astro/client",
            "node"
        ],

        // module system behavior
        "allowImportingTsExtensions": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "noUncheckedSideEffectImports": true,
        // https://www.typescriptlang.org/docs/handbook/release-notes/typescript-5-7.html#path-rewriting-for-relative-paths
        // can write out imports as .ts, not .js (supports direct execution, recommended by node's
        // docs for type-stripping https://nodejs.org/docs/latest-v22.x/api/typescript.html#type-stripping)
        "rewriteRelativeImportExtensions": true,
        "verbatimModuleSyntax": true,

        // output / publishing
        // "noEmitOnError": true,
        // "sourceMap": true,
        // "declaration": true,
        // "declarationMap": true,
        // File Layout
        "rootDir": ".",
        "outDir": "./dist",

        // typechecking
        "strict": true,
        "allowJs": true,
        "erasableSyntaxOnly": true,
        "exactOptionalPropertyTypes": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "noPropertyAccessFromIndexSignature": true,
        "noUncheckedIndexedAccess": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "exclude": [".plan", "./runtime-stub.js", "**/dist"]
}
